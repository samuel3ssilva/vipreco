# Ambiente local (staging legado, único ambiente até a Onda 2). Copie para `.env`.
# Para desenvolver/testar contra o ambiente de produção (quando existir), copie o mesmo
# formato para `.env.production` — nunca reaproveite os valores de um arquivo no outro.
# Depois de preencher, rode `bun run verify-env:staging` (ou `:production`) para confirmar
# que as variáveis realmente resolvem para o projeto Supabase esperado nesse ambiente,
# comparando com config/environments.json.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Origem pública do ambiente (sem barra final). Usada para montar a URL absoluta da og:image,
# que os aplicativos de mensagem exigem para exibir a prévia do link. Vazio = caminho relativo.
VITE_PUBLIC_SITE_URL=

# Modo do ambiente: vazio (ou qualquer outro valor) = demonstração, com faixa de ambiente, selo
# de dados fictícios e Achados vindos de fixture. `piloto` só com decisão explícita — nenhum
# ambiente está configurado para isso hoje.
VITE_APP_MODE=

# Destino único do CTA de WhatsApp, em formato internacional só com dígitos
# (DDI + DDD + número, ex.: 5519999999999). Vazio = o CTA não é renderizado.
# Nunca é um segredo: aparece no link público. Não colocar aqui nenhum token ou senha.
VITE_WHATSAPP_NUMBER=
